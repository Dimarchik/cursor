# Several comma-separated endpoints fail over automatically: a 429 rate limit
# moves to the next one at once, two other failures in a row do too. Free
# endpoints without sign-up (checked 2026-10-31), alternating providers so a
# switch lands on a different one. PublicNode refuses getMultipleAccounts,
# which prices all open positions in one call, so it is not first; a 403
# from it rotates on at once. A paid endpoint (Helius, Chainstack, QuickNode)
# can go first in the list.
SOLANA_NODE_RPC_ENDPOINT=https://api.mainnet-beta.solana.com,https://solana-rpc.publicnode.com,https://api.mainnet.solana.com,https://solana.publicnode.com,https://solana.leorpc.com/?api_key=FREE
# LeoRPC serves no WebSocket.
SOLANA_NODE_WSS_ENDPOINT=wss://api.mainnet-beta.solana.com,wss://solana-rpc.publicnode.com,wss://api.mainnet.solana.com,wss://solana.publicnode.com

GEYSER_ENDPOINT=
GEYSER_API_TOKEN=
GEYSER_AUTH_TYPE=x-token or basic

# Leave empty for a dry run (trade.dry_run: true).
SOLANA_PRIVATE_KEY=
